DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Retrieval: hybrid (dense+FTS fused by RRF) | fts | dense
MEMORY_SEARCH_MODE=hybrid
# Embedding model served by local Ollama — switch freely; the index
# auto-rebuilds when the model changes. Verified options:
#   bge-m3                 (1024d, 多语言, 中文强)
#   qwen3-embedding:0.6b   (1024d, 中英双语, 轻量)
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
RRF_RANK_CONSTANT=60
